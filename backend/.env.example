# Every setting the backend reads from the environment, with harmless values.
# `make setup` copies it to backend/.env, which holds each computer's values and
# secrets and is never committed. A new variable goes here too, with a comment.
#
# "compose.yaml wins": the development containers set it again, and a real
# environment variable wins over .env. "tests:": phpunit.xml sets its own.

# --- The app ---------------------------------------------------------------

# compose.yaml wins
APP_NAME=AtleoPlan
# Without it Laravel assumes production and asks before every migration.
# tests: testing
APP_ENV=local
# Filled by `make setup`; changing it signs everyone out
APP_KEY=
# Never true on a real server: it exposes code and settings
APP_DEBUG=true
# Inside the container (8500 from the computer). Not the browser's address,
# which is why the API sends photos as paths
APP_URL=http://localhost:8000
# The React app: links in emails, and Google's return address. compose.yaml wins
FRONTEND_URL=http://localhost:5673
# Where Google sends an admin back to; in production APP_URL + /admin
ADMIN_URL=http://localhost:8500/admin


# --- Languages -------------------------------------------------------------

# For a request with no Accept-Language; the React app always sends one
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# --- Maintenance mode ------------------------------------------------------

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Unused: the container runs FrankenPHP, not `php artisan serve`
# PHP_CLI_SERVER_WORKERS=4

# --- Passwords -------------------------------------------------------------

# tests: 4, so the many test sign-ups stay fast
BCRYPT_ROUNDS=12

# --- Logs ------------------------------------------------------------------

# storage/logs/laravel.log; `docker compose logs backend` shows the web
# server's own log
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database --------------------------------------------------------------

# compose.yaml wins: Postgres in the `postgres` container. tests:
# atleoplan_test, forced in phpunit.xml
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# --- Sessions --------------------------------------------------------------

# Sanctum signs the React app in with the session cookie. tests: array
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# null: the cookie belongs to the exact host, which keeps it working through
# Vite's proxy
SESSION_DOMAIN=null

# --- Background work and files ---------------------------------------------

# Unused. tests: null
BROADCAST_CONNECTION=log
# Private files; the exercises' photos use the `public` disk, served at /storage
FILESYSTEM_DISK=local
# Worked through by the `queue` container. tests: sync
QUEUE_CONNECTION=database

# --- Cache -----------------------------------------------------------------

# tests: array
CACHE_STORE=database
# CACHE_PREFIX=

# Laravel's defaults, unused: the database does their job
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Email -----------------------------------------------------------------

# compose.yaml wins: Mailpit catches every email, at http://localhost:8525.
# tests: array
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Amazon S3 -------------------------------------------------------------

# Unused: files stay on the server's own disk
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Sign in with Google ---------------------------------------------------

# Secrets: set in backend/.env only, then `docker compose restart backend`
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Laravel's own Vite ----------------------------------------------------

# For Laravel's Blade assets only; the React app has its own Vite
VITE_APP_NAME="${APP_NAME}"
