# ---------------------------------------------------------------------------
# backend/.env.example: every setting Laravel reads from the environment,
# with harmless values. Committed; the real file, backend/.env, is not.
#
# - `make setup` copies this file to backend/.env when it is missing, then
#   fills APP_KEY (docs/start/S1-setup.md S1.5). backend/.env holds this
#   computer's values and secrets: never committed (backend/.gitignore),
#   never shown, never read by an assistant.
# - A new variable goes here too, with an empty or harmless value and a
#   comment, so the other computer and the next person know it exists.
# - The code never reads these directly: each one feeds a value in
#   config/*.php through env('NAME', default), and the code asks config()
#   (docs/concepts/C2-backend.md C2.10).
# - In development, compose.yaml sets some of these again for the backend
#   container (`environment:`), and a variable already set in the
#   environment always wins over this file. Those are marked "compose.yaml
#   wins" below: the value here only matters outside Docker.
# - Tests use their own values for some, set in phpunit.xml ("tests: …").
# - Format: NAME=value, no spaces around `=`; quotes when the value has
#   spaces; "${OTHER}" reuses another variable; `#` starts a comment.
# ---------------------------------------------------------------------------

# --- The app ---------------------------------------------------------------

# The app's name: in the emails it sends and in the admin panel's title.
# compose.yaml wins (AtleoPlan).
APP_NAME=AtleoPlan
# Which kind of machine this is: local (development), testing, production.
# Without a .env Laravel assumes production and asks before every migration.
# tests: testing.
APP_ENV=local
# The secret key that encrypts cookies and sessions; filled by
# `php artisan key:generate` (`make setup` runs it). Changing it signs
# everyone out. Empty here on purpose: each computer has its own.
APP_KEY=
# true: an error shows a page with the code and the stack trace, and the
# answers to the React app carry the details. Never true on a real server:
# it shows the code and settings to anyone.
APP_DEBUG=true
# The address Laravel believes it has: inside the container it answers on
# port 8000 (from the computer it is 8500, docs/start/S1-setup.md S1.4).
# Used for the links Laravel builds itself, such as the public disk's file
# addresses; the API sends photos as paths, not full links, for this reason
# (app/Http/Resources/ExerciseResource.php).
APP_URL=http://localhost:8000
# Where the React app is (Vite in development): the links in emails, such as
# a password reset, lead there (app/Providers/FortifyServiceProvider.php);
# the return address from Google is built from it (S1.11). compose.yaml wins.
FRONTEND_URL=http://localhost:5673

# --- Languages -------------------------------------------------------------

# The language of a request that does not say which one it wants. The React
# app always says it, with Accept-Language
# (app/Http/Middleware/SetLocaleFromRequest.php, docs/design/D2-decisions.md D2.4).
APP_LOCALE=en
# The language used when a text is missing in the requested one.
APP_FALLBACK_LOCALE=en
# The language of the fake names and texts made by factories and seeders.
APP_FAKER_LOCALE=en_US

# --- Maintenance mode ------------------------------------------------------

# Where `php artisan down` notes that the app is closed: a file in storage/.
# With several servers, `database` (the line below) shares it between them.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Workers of `php artisan serve`, PHP's built-in server. Not used: the
# container runs FrankenPHP instead (docs/start/S1-setup.md S1.1).
# PHP_CLI_SERVER_WORKERS=4

# --- Passwords -------------------------------------------------------------

# How hard the password hash is to compute (bcrypt's cost): each +1 doubles
# the time, for whoever checks a password and for whoever tries to guess it.
# tests: 4, so the many test sign-ups stay fast.
BCRYPT_ROUNDS=12

# --- Logs ------------------------------------------------------------------

# Where Laravel writes what happens (config/logging.php): `stack` passes each
# message to the channels listed in LOG_STACK; `single` is one file,
# backend/storage/logs/laravel.log. `docker compose logs backend` shows the
# web server's own log instead.
LOG_CHANNEL=stack
LOG_STACK=single
# Warnings about features to be removed in a later version: not written.
LOG_DEPRECATIONS_CHANNEL=null
# The least serious message written: debug writes everything. A real server
# uses error or warning.
LOG_LEVEL=debug

# --- Database --------------------------------------------------------------

# A new Laravel app points at SQLite, a file. compose.yaml wins: PostgreSQL in
# the `postgres` container, database, user and password `atleoplan`
# (docs/how-to/H4-database-tools.md). tests: the atleoplan_test database,
# forced in phpunit.xml. The commented lines are the fields a server
# connection takes.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# --- Sessions: who is signed in --------------------------------------------

# Where the sessions live: the `sessions` table. The browser keeps only a
# cookie with the session's id; Sanctum signs the React app in with it
# (docs/concepts/C2-backend.md C2.7.1). tests: array, in memory.
SESSION_DRIVER=database
# Minutes of inactivity before a session ends.
SESSION_LIFETIME=120
# Whether the session's content is encrypted in the table as well.
SESSION_ENCRYPT=false
# The cookie is sent for every path of the address.
SESSION_PATH=/
# null: the cookie belongs to the exact address it came from (localhost),
# which is what keeps it working through Vite's proxy.
SESSION_DOMAIN=null

# --- Background work and files ---------------------------------------------

# Where events for live updates (websockets) go: only to the log, unused.
# tests: null.
BROADCAST_CONNECTION=log
# The default disk for files Laravel stores (config/filesystems.php): `local`
# is backend/storage/app/private, never served. The exercises' photos use
# the `public` disk instead (medialibrary's default), served at /storage.
FILESYSTEM_DISK=local
# Where queued jobs wait: the `jobs` table, worked through by the `queue`
# container (docs/concepts/C2-backend.md C2.9). compose.yaml wins (database too).
# tests: sync, each job run at once.
QUEUE_CONNECTION=database

# --- Cache -----------------------------------------------------------------

# Where Laravel keeps values it wants to remember for a while (sign-in
# attempts for throttling, among others): the `cache` table. tests: array.
CACHE_STORE=database
# A prefix for the keys, for when several apps share one cache store.
# CACHE_PREFIX=

# Memcached and Redis: other places for cache, sessions and queues. Laravel's
# defaults, not used here: no such service runs, the database does their job
# (compose.yaml, the comment above QUEUE_CONNECTION: "no Redis to run").
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Email -----------------------------------------------------------------

# How emails leave: `log` writes them in laravel.log instead of sending.
# compose.yaml wins: smtp to the `mailpit` container, port 1025, where every
# email is caught, readable at http://localhost:8525
# (docs/start/S1-setup.md S1.9). tests: array, kept in memory for the
# assertions. The other lines are a mail server's address and account.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# The sender of every email: the address and the name the reader sees.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Amazon S3 -------------------------------------------------------------

# A disk on Amazon S3 (or a compatible service) for files. Not used: files
# stay on the server's own disk (docs/design/D2-decisions.md D2.5).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Sign in with Google ---------------------------------------------------

# The OAuth client made in the Google Cloud Console with the owner's account
# (docs/start/S1-setup.md S1.11, docs/project/backlog.md FEAT-9). Secrets:
# the values go in backend/.env only, never here. After writing them,
# `docker compose restart backend`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Laravel's own Vite ----------------------------------------------------

# Passed to backend/vite.config.js, Laravel's own asset build for its Blade
# pages; read by nothing of ours. The React app is frontend/, with its own
# Vite (docs/concepts/C1-frontend.md C1.1).
VITE_APP_NAME="${APP_NAME}"
