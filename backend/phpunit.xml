<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <!--
        Settings for the test run. compose.yaml gives the containers the
        development database, mail and queue settings as real environment
        variables, which PHP puts in $_SERVER, and Laravel reads $_SERVER first.
        An <env> entry alone (even with force="true") only changes $_ENV and
        getenv(), so the variables set by compose.yaml are also set here as
        <server>: without them the tests would run on the development database,
        and RefreshDatabase would empty it. tests/Feature/TestDatabaseTest.php
        fails if this is ever lost.
    -->
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Postgres like production, in its own database (docker/postgres/init); host, user and password come from compose.yaml -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="atleoplan_test" force="true"/>
        <server name="DB_DATABASE" value="atleoplan_test"/>
        <env name="DB_URL" value="" force="true"/>
        <server name="DB_URL" value=""/>
        <!-- Emails kept in memory, jobs run at once: nothing reaches Mailpit or the worker -->
        <env name="MAIL_MAILER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
