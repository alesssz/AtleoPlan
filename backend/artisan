#!/usr/bin/env php
<?php

/**
 * Artisan, Laravel's command-line tool: `php artisan migrate`,
 * `php artisan make:model`, `php artisan test`... (docs/concepts/C2-backend.md C2.13).
 *
 * The first line (the "shebang") lets the system run this file as a PHP
 * script. In this project PHP runs only in Docker, so commands go through
 * the container: `make artisan c="route:list"` or
 * `docker compose exec backend php artisan route:list`.
 *
 * It is the command-line twin of public/index.php: it builds the same
 * application (bootstrap/app.php) but hands it a command instead of an HTTP
 * request. The commands come from Laravel, from the packages, and from
 * routes/console.php.
 */

use Illuminate\Foundation\Application;
use Symfony\Component\Console\Input\ArgvInput;

// The start time, as in public/index.php
define('LARAVEL_START', microtime(true));

// Register the Composer autoloader...
// From here on classes load by themselves from their namespace (docs/concepts/C2-backend.md C2.1)
require __DIR__.'/vendor/autoload.php';

// Bootstrap Laravel and handle the command...
/** @var Application $app */
$app = require_once __DIR__.'/bootstrap/app.php';

// ArgvInput reads the words typed after `php artisan`; the command's exit
// code (0 = success) is kept in $status
$status = $app->handleCommand(new ArgvInput);

// Hands the exit code to the shell, so scripts and `make` see a failure
exit($status);
