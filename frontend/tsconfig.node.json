{
  // TypeScript settings for the build configuration (vite.config.ts), which
  // runs in Node, not in the browser: Node's types instead of the DOM's.
  // Same ideas as tsconfig.app.json, which comments each option; checked
  // by `npm run typecheck` through tsconfig.json.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    // Modern JavaScript only: no browser objects (document, window)
    "lib": ["ES2023"],
    // Node's own types (process.env, node:url…)
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    // Node's own way of resolving imports
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts"]
}
